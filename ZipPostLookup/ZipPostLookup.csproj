<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net8.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<AssemblyName>ZipPostLookup</AssemblyName>
		<RootNamespace>ZipPostLookup</RootNamespace>
		<LangVersion>latest</LangVersion>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>

		<!-- Package identity -->
		<PackageId>ZipPostLookup</PackageId>
		<Version>1.0.0</Version>
		<Authors>jamesrtyrrell</Authors>
		<Copyright>Copyright ©James.r.Tyrrell 2026</Copyright>

		<!-- Package description -->
		<Description>Fast, zero-allocation postal code lookup for .NET 8+. Built-in data for US (41k zip codes), Canada (891k postal codes) and Mexico (32k postal codes). Lookup by zip/postal code, city, state, province and IANA timezone. FrozenDictionary-backed for low-allocation hot paths. Extensible via ICodeDataSource. For .NET Standard 2.0 / .NET Framework support use the ZipPostLookup.Legacy package.</Description>
		<PackageTags>dotnet;csharp;zipcode;postal-code;geocoding;address-lookup;timezone;nuget;canada;mexico</PackageTags>
		<PackageReadmeFile>README.MD</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>

		<!-- Repository links -->
		<PackageProjectUrl>https://github.com/jamesrtyrrell/ZipPostLookup</PackageProjectUrl>
		<RepositoryUrl>https://github.com/jamesrtyrrell/ZipPostLookup</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<!-- Symbols for debugging support -->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Data\us\us.csv.br" />
		<EmbeddedResource Include="Data\ca\ca.csv.br" />
		<EmbeddedResource Include="Data\mx\mx.csv.br" />
	</ItemGroup>

	<!-- ZP frozen images. Filename convention: {cc}.u16.zpi.br or {cc}.u32.zpi.br. -->
	<ItemGroup>
		<EmbeddedResource Include="Data\us\us*.zpi.br" />
		<EmbeddedResource Include="Data\ca\ca*.zpi.br" />
		<EmbeddedResource Include="Data\mx\mx*.zpi.br" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.MD" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Data\ca\" />
		<Folder Include="Data\mx\" />
	</ItemGroup>

</Project>